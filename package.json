{
  "name": "@zyf_dsb/me-ui",
  "version": "0.0.4",
  "description": "A Vue 3 UI component library",
  "license": "MIT",
  "author": "ZYF <3252667584@qq.com>",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "component-library",
    "me-ui"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/user-ZYF/me-ui.git"
  },
  "bugs": {
    "url": "https://github.com/user-ZYF/me-ui/issues"
  },
  "homepage": "https://github.com/user-ZYF/me-ui#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/button.js"
    },
    "./checkbox": {
      "types": "./dist/components/checkbox/index.d.ts",
      "import": "./dist/checkbox.js"
    },
    "./config-provider": {
      "types": "./dist/components/config-provider/index.d.ts",
      "import": "./dist/config-provider.js"
    },
    "./form": {
      "types": "./dist/components/form/index.d.ts",
      "import": "./dist/form.js"
    },
    "./icon": {
      "types": "./dist/components/icon/index.d.ts",
      "import": "./dist/icon.js"
    },
    "./input": {
      "types": "./dist/components/input/index.d.ts",
      "import": "./dist/input.js"
    },
    "./modal": {
      "types": "./dist/components/modal/index.d.ts",
      "import": "./dist/modal.js"
    },
    "./pagination": {
      "types": "./dist/components/pagination/index.d.ts",
      "import": "./dist/pagination.js"
    },
    "./radio": {
      "types": "./dist/components/radio/index.d.ts",
      "import": "./dist/radio.js"
    },
    "./select": {
      "types": "./dist/components/select/index.d.ts",
      "import": "./dist/select.js"
    },
    "./tag": {
      "types": "./dist/components/tag/index.d.ts",
      "import": "./dist/tag.js"
    },
    "./table": {
      "types": "./dist/components/table/index.d.ts",
      "import": "./dist/table.js"
    },
    "./tooltip": {
      "types": "./dist/components/tooltip/index.d.ts",
      "import": "./dist/tooltip.js"
    },
    "./tree": {
      "types": "./dist/components/tree/index.d.ts",
      "import": "./dist/tree.js"
    },
    "./scrollbar": {
      "types": "./dist/components/scrollbar/index.d.ts",
      "import": "./dist/scrollbar.js"
    },
    "./virtual-list": {
      "types": "./dist/components/virtual-list/index.d.ts",
      "import": "./dist/virtual-list.js"
    },
    "./styles/*": "./dist/*.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.less",
    "**/*.vue",
    "src/setup.ts",
    "dist/setup*.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^14.4.0",
    "async-validator": "^4.2.5",
    "js-easing-functions": "^1.0.3",
    "lodash": "^4.17.21",
    "uuid": "^14.0.1",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.25",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.6",
    "ant-design-vue": "^4.2.6",
    "autoprefixer": "^10.5.4",
    "element-plus": "^2.14.6",
    "eslint": "^10.9.0",
    "eslint-plugin-vue": "^10.10.0",
    "js-easing-functions": "^1.0.3",
    "jsdom": "^24.1.0",
    "less": "^4.2.0",
    "typescript": "^5.5.0",
    "uuid": "^14.0.1",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^5.1.0",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^2.0.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
